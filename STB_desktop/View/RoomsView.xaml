<UserControl x:Class="STB_desktop.View.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STB_desktop.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0"  Margin="5" Content="Adatok betöltése" Height="30" Width="150" Command="{Binding LoadItemsCommand}"/>

        <!-- Adatok megjelenítése -->
        <DataGrid ItemsSource="{Binding Items}"
       AutoGenerateColumns="False" IsReadOnly="True"
         Grid.Row="1"
             CanUserAddRows="False" 
             SelectionMode="Single" 
                 SelectionUnit="FullRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Terem neve" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Típus" Binding="{Binding Roomtype}" Width="100"/>
                <DataGridTextColumn Header="Kapacitás (fő)" Binding="{Binding Capacity}" Width="100"/>
                <DataGridTextColumn Header="Óradíj (Kredit)" Binding="{Binding BaseCreditPricePerHour}" Width="120"/>
                <DataGridCheckBoxColumn Header="Aktív" Binding="{Binding IsActive}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
