<Window
  x:Class="STB_desktop.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:viewmodels="clr-namespace:STB_desktop.ViewModel"
  xmlns:views="clr-namespace:STB_desktop.View"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="Smart Tech Base Desktop
" Height="450" Width="800">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:RoomsViewModel}">
            <views:RoomsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AssetViewModel}">
            <views:AssetView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background= "Beige" Margin="10" >
    <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Smart Tech Base Desktop" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
        <TextBlock Text="Admin felület" HorizontalAlignment="Center"
                   FontSize="20" TextWrapping="Wrap" Margin="10" Grid.Row="1"/>
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Terem neve:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>
            
            
            <TextBlock Text="Típus:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TypeTextBox" Grid.Row="1" Grid.Column="4" Margin="5"/>
            
            <TextBlock Text="Kapacitás (fő):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="CapacityTextBox" Grid.Row="2" Grid.Column="1" Margin="5"/>
            
            <TextBlock Text="Óradíj (Kredit):" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="BaseCreditPricePerHourTextBox" Grid.Row="2" Grid.Column="4" Margin="5"/>
            <TextBlock Text="Aktív:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
            <CheckBox x:Name="IsActiveCheckBox" Grid.Row="4" Grid.Column="1" Margin="5"/>
        </Grid>
        
        <Grid Grid.Row="6">
            <Border Margin="0,0,0,5" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                        <!-- Bal oldali menü sáv -->
                        <ColumnDefinition Width="*"/>
                        <!-- Jobb oldali tartalom -->
                    </Grid.ColumnDefinitions>

                    <!-- BAL OLDAL: Navigációs menü -->
                    <Border Grid.Column="0" Background="#2D2D30">
                        <StackPanel Margin="10">
                            <TextBlock Text="FŐMENÜ" Foreground="White" FontWeight="Bold" Margin="0,0,0,20"/>

                            <!-- A gomb a MainViewModel NavigateToRoomsCommand parancsát hívja -->
                            <Button Content="Termek Kezelése" Command="{Binding NavigateToRoomsCommand}" 
                        Padding="10" Margin="0,5" Background="#3E3E42" Foreground="White"/>

                            <!-- Későbbi gombok helye -->
                            <Button Content="Eszközök" Command="{Binding NavigateToAssetsCommand}" 
                                    Padding="10" Margin="0,5" Background="#3E3E42" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- JOBB OLDAL: A dinamikusan változó tartalom -->
                    <!-- Ez automatikusan kicserélődik a CurrentViewModel alapján -->
                    <ContentControl Grid.Column="1" Margin="10" Content="{Binding CurrentViewModel}" />
                </Grid>


            </Border>
        </Grid>
    </Grid>
</Window>
